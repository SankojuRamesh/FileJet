# Reverse proxy, plain HTTP (http://DOMAIN). For HTTPS remove the "http://" prefix (certificate is automatic).
http://{$P2P_DOMAIN} {
	encode zstd gzip
	# WebSockets: connection setup and presence (signaling server)
	reverse_proxy /ws signaling:8765
	reverse_proxy /ws/presence signaling:8765
	reverse_proxy /healthz signaling:8765
	# Everything else: the cloud app (web dashboard + REST API)
	reverse_proxy cloud:8000
}
