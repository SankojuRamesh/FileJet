# ---- MediaRush server settings (copy to .env and fill in) ----

# Public DNS name of the server. Users enter https://<this>/ as the cloud URL in the MediaRush app.
P2P_DOMAIN=iotgateway.live

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=change-me
P2P_CLOUD_JWT_SECRET=change-me-shared-by-cloud-and-signaling
POSTGRES_PASSWORD=change-me

# dummy = plan changes apply immediately without payment (self-hosting / development)
BILLING_PROVIDER=dummy

# E-mail (folder invitations, upload notifications) - your SMTP provider
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=MediaRush <no-reply@iotgateway.live>
